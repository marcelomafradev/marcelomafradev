# Spotify — absent → now-playing/favorites degrade to idle/empty
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_FAVORITE_SONGS_LIMIT=10

# YouTube — absent YOUTUBE_API_KEY and GOOGLE_API_KEY → search returns 503 / url:null
YOUTUBE_API_KEY=
GOOGLE_API_KEY=

# Contact form SMTP — absent SMTP_HOST/USER/PASSWORD → API 503, form falls back to mailto:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_TO_EMAIL=

# Site URL — defaults to https://www.marcelomafradev.com.br when unset
NEXT_PUBLIC_SITE_URL=https://www.marcelomafradev.com.br
